<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Safe Railway Suite" verbose="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Safe Railway Regression" preserve-order="true">
        <classes>
            <class name="testcases.LoginTest"/>
            <class name="testcases.LogoutTest"/>
            <class name="testcases.RegisterTest"/>
            <class name="testcases.ResetPasswordTest"/>
            <class name="testcases.BookTicketTest"/>
            <class name="testcases.CancelTicketTest"/>
        </classes>
    </test>

    <test name="Exercises" preserve-order="true">
        <classes>
            <class name="Exercise2.FirstSeleniumTest"/>
            <class name="Exercise3.Exercise3"/>
            <class name="Exercise5And8.Exercise5And8"/>
        </classes>
    </test>

</suite>