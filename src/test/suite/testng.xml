<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Safe Railway Suite" verbose="1" parallel="classes" thread-count="2">

    <listeners>
        <listener class-name="common.listeners.TestListener"/>
    </listeners>

    <test name="Chrome" preserve-order="true">
        <parameter name="browser" value="Chrome"/>
        <classes>
            <class name="testcases.LoginTest"/>
            <class name="testcases.LogoutTest"/>
            <class name="testcases.RegisterTest"/>
            <class name="testcases.ResetPasswordTest"/>
            <class name="testcases.BookTicketTest"/>
            <class name="testcases.CancelTicketTest"/>
            <class name="Exercise3.Exercise3"/>
            <class name="Exercise5And8.Exercise5And8"/>
        </classes>
    </test>

    <test name="Edge" preserve-order="true">
        <parameter name="browser" value="Edge"/>
        <classes>
            <class name="testcases.LoginTest"/>
            <class name="testcases.LogoutTest"/>
            <class name="testcases.RegisterTest"/>
            <class name="testcases.ResetPasswordTest"/>
            <class name="testcases.BookTicketTest"/>
            <class name="testcases.CancelTicketTest"/>
            <class name="Exercise3.Exercise3"/>
            <class name="Exercise5And8.Exercise5And8"/>
        </classes>
    </test>

</suite>